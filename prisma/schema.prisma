// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  NEW
  REVIEWED
  CONTACTED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR_1
  SUPERVISOR_2
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  password  String   @db.Text
  name      String   @db.VarChar(150)
  role      UserRole @default(SUPERVISOR_2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model BlogPost {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique @db.VarChar(200)
  title       String     @db.VarChar(255)
  excerpt     String     @db.Text
  content     String     @db.Text
  category    String     @db.VarChar(100)
  coverImage  String?    @map("cover_image") @db.Text
  authorName  String     @default("New Era Editorial Team") @map("author_name") @db.VarChar(100)
  readTime    String     @default("5 min read") @map("read_time") @db.VarChar(50)
  status      PostStatus @default(PUBLISHED)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  category  String   // 'Healthcare', 'Hospitality', 'Housing'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model ClientRequest {
  id               String            @id @default(uuid()) @db.Uuid
  organizationName String            @map("organization_name") @db.VarChar(150)
  contactName      String            @map("contact_name") @db.VarChar(100)
  email            String            @db.VarChar(255)
  phone            String            @db.VarChar(50)
  location         String            @db.VarChar(150)
  requiredRoles    String[]          @map("required_roles")
  shiftUrgency     String?           @map("shift_urgency") @db.VarChar(50)
  notes            String?           @db.Text
  status           ApplicationStatus @default(NEW)
  createdAt        DateTime          @default(now()) @map("created_at")

  @@map("client_requests")
}

model CandidateApplication {
  id              String            @id @default(uuid()) @db.Uuid
  fullName        String            @map("full_name") @db.VarChar(120)
  email           String            @db.VarChar(255)
  phone           String            @db.VarChar(50)
  interestedRoles String[]          @map("interested_roles")
  hasValidDbs     Boolean           @default(false) @map("has_valid_dbs")
  hasRightToWork  Boolean           @default(true) @map("has_right_to_work")
  resumeFileUrl   String            @map("resume_file_url") @db.Text
  availability    String?           @db.VarChar(50) // 'Full-Time', 'Part-Time', 'Nights/Weekends'
  status          ApplicationStatus @default(NEW)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("candidate_applications")
}

model GeneralInquiry {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String?  @db.VarChar(200)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("general_inquiries")
}
